<?xml version="1.0" encoding="utf-8"?>
<!--
  코드 커버리지 수집 설정 (coverlet.collector).

  실행은 Server/run-coverage.ps1이 감싸고 있다. 직접 부를 때는
  dotnet test에 collect:"XPlat Code Coverage" 와 settings 옵션을 함께 준다.
  (XML 주석 안에는 하이픈 두 개를 쓸 수 없어 옵션 표기를 풀어 적었다)

  ⚠️ 필터 없이 돌리면 숫자가 쓸모없다. MemoryPack 생성물(*.g.cs)이 전체 라인의
     절반을 넘게 차지해, 손으로 쓴 코드가 얼마나 덮였는지가 그 안에 묻힌다
     (필터 전 전체 17.5% ← 대부분이 안 덮인 생성 코드였다).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!--
            생성 코드 제외.
            MemoryPack 포매터에는 [GeneratedCode] 속성이 붙지 않고
            `// <auto-generated/>` 주석만 있어 ExcludeByAttribute로는 걸리지 않는다.
            파일 패턴으로 걸어야 한다.
          -->
          <ExcludeByFile>**/*.g.cs</ExcludeByFile>

          <!--
            측정 대상은 WSGameServer(게임 서버 로직)뿐이다.

            - MikaNetwork.* : 게임을 모르는 재사용 프레임워크. 관심사가 달라
                              섞이면 "게임 로직이 얼마나 덮였나"가 흐려진다.
                              (유휴 세션 스윕처럼 게임 규칙에 걸린 부분은
                               WSGameServer 쪽 테스트가 이미 잡는다)
            - MikaUtils      : 같은 Lib 소속인데 어셈블리 이름에 MikaNetwork가
                               없어 위 패턴에 걸리지 않는다. 따로 적는다.
            - MikaProtocol   : 패킷 DTO. 프로퍼티 선언뿐이라 덮을 로직이 없다.
            - GameData       : 엑셀에서 생성된 테이블 정의. 사람이 쓰지 않는다.
          -->
          <Exclude>[MikaNetwork.*]*,[MikaUtils]*,[MikaProtocol]*,[GameData]*</Exclude>

          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>

          <!-- 테스트가 없는 어셈블리를 0%로 끌어와 평균을 흐리지 않는다. -->
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
